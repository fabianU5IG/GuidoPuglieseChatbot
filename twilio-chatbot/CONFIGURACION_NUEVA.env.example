# Plantilla principal de Teleconsulta
TWILIO_TELECONSULTA_TEMPLATE_SID=HX18e7c4eb9b23f2fbb53b37f1c2520bed

# Recomendaciones de IA para todo el flujo de agendamiento.
# Valores para desactivar: false, 0, off o no.
AI_GLOBAL_SCHEDULING_ENABLED=true

# Identificación de la cita en SaludTools
SALUDTOOLS_TELECONSULTATION_APPOINTMENT_TYPE=Teleconsulta / lectura de estudios

# Use únicamente un valor de modalidad válido en su instancia de SaludTools.
# Si se omite, se utiliza SALUDTOOLS_APPOINTMENT_MODALITY.
SALUDTOOLS_TELECONSULTATION_MODALITY=CONVENTIONAL
