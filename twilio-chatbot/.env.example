# =====================================================================
# Variables de entorno del chatbot (twilio-chatbot)
# Copia este archivo a ".env" y llena los valores reales.
# El archivo ".env" nunca se sube a git (ver .gitignore).
# =====================================================================

# --- Servidor -----------------------------------------------------
PORT=3000

# --- Twilio (REQUERIDO: si falta SID o AUTH_TOKEN, el servidor no arranca) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp del consultorio, formato "+57XXXXXXXXXX"
# (o el número del WhatsApp Sandbox de Twilio si estás probando: +14155238886)
# Este es el default que ya estaba hardcodeado en services/whatsapp.service.js:
TWILIO_WHATSAPP_NUMBER=+573114811385
# REQUERIDO para que los botones/menús con plantilla (Content Template) se envíen bien.
# NO tiene default en el código — esto sí lo debes sacar de Twilio Console > Messaging > Services.
TWILIO_MESSAGING_SERVICE_SID=
# Número de WhatsApp de la secretaría (default hardcodeado en el código):
SECRETARY_WHATSAPP_NUMBER=+573203269984

# --- SIDs de Content Templates de Twilio (opcional, ya tienen valor por defecto en el código) ---
# Solo llénalos si vas a usar plantillas distintas a las que ya están hardcodeadas.
# TWILIO_TELECONSULTA_TEMPLATE_SID=
# TWILIO_TEMPLATE_ASK_DOC_TYPE_SID=
# TWILIO_TEMPLATE_SUPPORT_DOC_TYPE_SID=
# TWILIO_TEMPLATE_AVAILABLE_HOURS_SID=
# TWILIO_TEMPLATE_SUPPORT_AVAILABLE_HOURS_SID=

# --- Imágenes postoperatorias -------------------------------------
# La imagen se guarda en MySQL y se expone temporalmente por una URL propia.
# En local NO hace falta definir PUBLIC_BASE_URL si Twilio entra por ngrok:
# el bot toma automáticamente el host HTTPS del webhook entrante.
# Si quieres forzarlo (o en producción), usa por ejemplo:
# PUBLIC_BASE_URL=https://bot.tudominio.com
# Horas de vigencia de la URL. Usa 0 si no quieres expiración.
POST_SURGERY_MEDIA_TTL_HOURS=72
# Tamaño máximo por imagen (16 MiB por defecto).
POST_SURGERY_MEDIA_MAX_BYTES=16777216
# SID de la plantilla Media para la secretaria. Si se omite, usa el SID actual.
TWILIO_POST_SURGERY_IMAGE_TEMPLATE_SID=HX35cb52ef7fc6c9d1e4a1135bdabbbd4e

# --- Azure OpenAI (REQUERIDO: si falta la API key, el servidor no arranca) ---
# Se usa para las recomendaciones de fecha/hora con IA.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# --- Base de datos MySQL (necesaria para casi todo el flujo de citas) ---
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=


# --- Memoria de sesión --------------------------------------------
# Minutos de inactividad después de los cuales se olvidan los datos
# temporales/identificativos guardados para esa conversación.
CHAT_SESSION_TTL_MINUTES=60

# --- Saludtools (sistema de citas de la clínica) -------------------
SALUDTOOLS_HOST=https://saludtools.carecloud.com.co/
SALUDTOOLS_APIKEY=
SALUDTOOLS_APISECRET=
# Secreto compartido para /webhook/saludtools/* (encabezado X-Saludtools-Secret).
# Debe configurarse igual en el panel de Saludtools. Si se deja vacío, esas rutas
# quedan sin autenticación (se advierte en el log al iniciar el servidor).
SALUDTOOLS_WEBHOOK_SECRET=
# Estos ya tienen valor por defecto en el código; solo cámbialos si aplica:
# SALUDTOOLS_DOCTOR_DOCUMENT_TYPE=1
# SALUDTOOLS_DOCTOR_DOCUMENT_NUMBER=72134079
# SALUDTOOLS_CLINIC_ID=18569
# SALUDTOOLS_APPOINTMENT_MODALITY=CONVENTIONAL
# SALUDTOOLS_APPOINTMENT_STATE=PENDING
# SALUDTOOLS_APPOINTMENT_TYPE=Pruebas Luis
# SALUDTOOLS_APPOINTMENT_DURATION_MIN=20
# SALUDTOOLS_TELECONSULTATION_MODALITY=
# SALUDTOOLS_DEBUG=false
# SALUDTOOLS_MIN_INTERVAL_MS=5000
# SALUDTOOLS_RETRY_429_WAIT_MS=70000
# Para bloquear horarios: registra en Saludtools un paciente reservado para
# esto (ej. "BLOQUEO CONSULTORIO") y pon su documento aquí. El worker revisa
# periódicamente las citas de ese paciente y las trae a la copia local, para
# que el bot deje de ofrecer esos horarios. Sin esto configurado, no pasa nada.
# SALUDTOOLS_BLOCK_DOCUMENT_TYPE=1
# SALUDTOOLS_BLOCK_DOCUMENT_NUMBER=

# --- IA para agendamiento (opcional, activada por defecto) --------
# AI_GLOBAL_SCHEDULING_ENABLED=true

# --- IA para navegación de flujo (fallback cuando no coincide ningún botón) ---
# AI_NAV_FALLBACK_ENABLED=true
# AI_NAV_FALLBACK_MIN_CONFIDENCE=0.7

# --- Secretaría --------------------------------------------------
# Números autorizados como secretaría, separados por coma.
# Se acepta con +57, solo dígitos o incluso con prefijo whatsapp:.
# Ejemplo para el número actual de secretaría:
SECRETARY_PHONES=+573153573131
